database -open waves -into waves.shm -default
probe -create -shm tb_encryption.keyxSI tb_encryption.associated_dataxSI tb_encryption.check_time tb_encryption.cipher_text tb_encryption.cipher_textxSO tb_encryption.clk tb_encryption.ctr tb_encryption.encryption_readyxSO tb_encryption.encryption_startxSI tb_encryption.noncexSI tb_encryption.plain_textxSI tb_encryption.r_64xSI tb_encryption.r_128xSI tb_encryption.r_ptxSI tb_encryption.rst tb_encryption.tag tb_encryption.tagxSO
run
